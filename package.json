{
  "name": "rebbehub",
  "private": true,
  "description": "RebbeHub: the open, community-edited index of Chabad Torah and media.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shmuky/RebbeHub.git"
  },
  "homepage": "https://rebbehub.org",
  "bugs": {
    "url": "https://github.com/shmuky/RebbeHub/issues"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck -w @rebbehub/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run build:web && npm test && npm run catalog:check",
    "catalog:check": "tsx services/jobs/src/bin/rebbehub.ts schema-check",
    "db:migrate": "tsx services/jobs/src/bin/rebbehub.ts migrate",
    "dev:api": "tsx services/api/src/node.ts",
    "rebbehub": "tsx services/jobs/src/bin/rebbehub.ts",
    "dev:web": "npm run dev -w @rebbehub/web",
    "build:web": "npm run build -w @rebbehub/web",
    "cloudflare:setup": "scripts/cloudflare-setup.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
